# ─────────────────────────────────────────────────────────────
# CYBER AI — Variables d'environnement (exemple)
# Copier en `.env` et renseigner. NE JAMAIS committer le vrai .env.
# Toutes les clés externes sont OPTIONNELLES : l'app démarre sans.
# ─────────────────────────────────────────────────────────────

# --- Général ---
ENVIRONMENT=development            # development | production
LOG_LEVEL=INFO
# Origines autorisées pour le frontend (séparées par des virgules)
CORS_ORIGINS=http://localhost:3000

# --- Sécurité ---
# Générer : openssl rand -hex 32
SECRET_KEY=change-me-dev-only-generate-a-real-one
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- PostgreSQL ---
POSTGRES_USER=cyberai
POSTGRES_PASSWORD=cyberai
POSTGRES_DB=cyberai
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Qdrant (vectoriel) ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# --- MinIO (stockage objet S3) ---
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=cyberai
MINIO_ROOT_PASSWORD=cyberai-minio
MINIO_BUCKET=cyberai

# --- LLM : fournisseurs (tous optionnels) ---
# Ollama local (gratuit) — laisser tel quel si Ollama tourne sur l'hôte
OLLAMA_BASE_URL=http://host.docker.internal:11434
DEFAULT_LOCAL_MODEL=qwen2.5:7b-instruct
DEFAULT_EMBED_MODEL=nomic-embed-text

# API distante pour le raisonnement complexe (remplir si disponible)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
# Modèle distant par défaut (format LiteLLM), ex. anthropic/claude-..., openai/gpt-...
DEFAULT_REMOTE_MODEL=

# --- OSINT / CTI (optionnels, activés si renseignés) ---
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SECURITYTRAILS_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
HIBP_API_KEY=
